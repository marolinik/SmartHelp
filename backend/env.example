# PIO Help Desk - Environment Variables
# Конфигурација за PIO Help Desk систем

# Сервер конфигурација
PORT=5000
NODE_ENV=development

# База података (PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Токени
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="30d"

# Active Directory / LDAP конфигурација
AD_URL="ldap://pio.gov.rs"
AD_BASE_DN="DC=pio,DC=gov,DC=rs"
AD_USERNAME="service_account@pio.gov.rs"
AD_PASSWORD="service_account_password"

# Email конфигурација (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@pio.gov.rs

# Логовање
LOG_LEVEL=info

# Redis (за кеширање)
REDIS_URL="redis://localhost:6379"

# Elasticsearch (за претрагу)
ELASTICSEARCH_URL="http://localhost:9200"

# OpenAI Configuration (for AI features)
OPENAI_API_KEY=your-openai-api-key

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_PATH=./uploads

# Logging Configuration
LOG_FILE=./logs/app.log

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000 