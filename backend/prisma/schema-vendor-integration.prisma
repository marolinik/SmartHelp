// Vendor Integration Schema Extension for PIO Help Desk System
// This file contains the vendor integration data model
// Supporting bidirectional ticket synchronization with Serbian language content

// Vendor System Configuration
model VendorSystem {
  id                String    @id @default(cuid())
  name              String    @unique // Naziv vendor sistema (UTF-8)
  displayName       String    @map("display_name") // Prikaz naziv (UTF-8)
  description       String?   // Opis sistema (UTF-8)
  vendorType        String    @map("vendor_type") // jira, servicenow, zendesk, freshdesk, custom
  apiVersion        String?   @map("api_version") // API verzija
  baseUrl           String?   @map("base_url") // Base URL za API
  documentation     String?   // Link ka dokumentaciji
  isActive          Boolean   @default(true) @map("is_active")
  supportsBidirectional Boolean @default(true) @map("supports_bidirectional")
  supportsWebhooks  Boolean   @default(false) @map("supports_webhooks")
  supportsPolling   Boolean   @default(true) @map("supports_polling")
  rateLimitPerMinute Int?     @map("rate_limit_per_minute")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  connections       VendorConnection[]
  fieldMappings     VendorFieldMapping[]
  statusMappings    VendorStatusMapping[]
  priorityMappings  VendorPriorityMapping[]
  categoryMappings  VendorCategoryMapping[]
  webhooks          VendorWebhook[]

  @@map("vendor_systems")
}

// Vendor Connection Details
model VendorConnection {
  id                String    @id @default(cuid())
  vendorSystemId    String    @map("vendor_system_id")
  connectionName    String    @map("connection_name") // Naziv konekcije (UTF-8)
  environment       String    @default("production") // production, staging, test
  authType          String    @map("auth_type") // oauth2, api_key, basic, custom
  authConfig        String    @map("auth_config") // Encrypted JSON with auth details
  endpointUrl       String?   @map("endpoint_url") // Specific endpoint URL
  isActive          Boolean   @default(true) @map("is_active")
  lastConnectedAt   DateTime? @map("last_connected_at")
  lastSyncAt        DateTime? @map("last_sync_at")
  connectionStatus  String    @default("pending") @map("connection_status") // pending, active, failed, suspended
  errorMessage      String?   @map("error_message") // Poslednja greška (UTF-8)
  syncDirection     String    @default("bidirectional") @map("sync_direction") // inbound, outbound, bidirectional
  pollingInterval   Int       @default(300) @map("polling_interval_seconds") // For polling-based sync
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  vendorSystem      VendorSystem         @relation(fields: [vendorSystemId], references: [id])
  syncHistory       VendorSyncHistory[]
  syncQueue         VendorSyncQueue[]
  syncErrors        VendorSyncError[]
  ticketMappings    VendorTicketMapping[]

  @@index([vendorSystemId, isActive])
  @@map("vendor_connections")
}

// Field Mapping Configuration
model VendorFieldMapping {
  id                String    @id @default(cuid())
  vendorSystemId    String    @map("vendor_system_id")
  entityType        String    @map("entity_type") // ticket, comment, attachment, user
  internalField     String    @map("internal_field") // Naše polje
  vendorField       String    @map("vendor_field") // Vendor polje
  fieldType         String    @map("field_type") // string, number, date, boolean, json
  transformationType String?  @map("transformation_type") // none, custom, date_format, number_format
  transformationConfig String? @map("transformation_config") // JSON config for transformation
  isRequired        Boolean   @default(false) @map("is_required")
  defaultValue      String?   @map("default_value") // Default vrednost (UTF-8)
  direction         String    @default("bidirectional") // inbound, outbound, bidirectional
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  vendorSystem VendorSystem @relation(fields: [vendorSystemId], references: [id])

  @@index([vendorSystemId, entityType, isActive])
  @@unique([vendorSystemId, entityType, internalField])
  @@map("vendor_field_mappings")
}

// Status Mapping
model VendorStatusMapping {
  id                String    @id @default(cuid())
  vendorSystemId    String    @map("vendor_system_id")
  internalStatus    String    @map("internal_status") // Naš status
  vendorStatus      String    @map("vendor_status") // Vendor status
  vendorStatusName  String?   @map("vendor_status_name") // Display ime (UTF-8)
  description       String?   // Opis mapiranja (UTF-8)
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  vendorSystem VendorSystem @relation(fields: [vendorSystemId], references: [id])

  @@unique([vendorSystemId, internalStatus])
  @@index([vendorSystemId, isActive])
  @@map("vendor_status_mappings")
}

// Priority Mapping
model VendorPriorityMapping {
  id                String    @id @default(cuid())
  vendorSystemId    String    @map("vendor_system_id")
  internalPriority  String    @map("internal_priority") // low, medium, high, critical
  vendorPriority    String    @map("vendor_priority") // Vendor priority value
  vendorPriorityName String?  @map("vendor_priority_name") // Display ime (UTF-8)
  numericValue      Int?      @map("numeric_value") // For sorting
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  vendorSystem VendorSystem @relation(fields: [vendorSystemId], references: [id])

  @@unique([vendorSystemId, internalPriority])
  @@index([vendorSystemId, isActive])
  @@map("vendor_priority_mappings")
}

// Category Mapping
model VendorCategoryMapping {
  id                String    @id @default(cuid())
  vendorSystemId    String    @map("vendor_system_id")
  internalCategoryId String   @map("internal_category_id")
  vendorCategory    String    @map("vendor_category") // Vendor category identifier
  vendorCategoryName String?  @map("vendor_category_name") // Display ime (UTF-8)
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  vendorSystem VendorSystem @relation(fields: [vendorSystemId], references: [id])
  internalCategory Category @relation(fields: [internalCategoryId], references: [id])

  @@unique([vendorSystemId, internalCategoryId])
  @@index([vendorSystemId, isActive])
  @@map("vendor_category_mappings")
}

// Ticket Mapping for Synchronization
model VendorTicketMapping {
  id                String    @id @default(cuid())
  connectionId      String    @map("connection_id")
  internalTicketId  String    @map("internal_ticket_id")
  vendorTicketId    String    @map("vendor_ticket_id")
  vendorTicketKey   String?   @map("vendor_ticket_key") // e.g., JIRA-1234
  lastSyncAt        DateTime? @map("last_sync_at")
  lastSyncDirection String?   @map("last_sync_direction") // inbound, outbound
  syncStatus        String    @default("active") @map("sync_status") // active, suspended, error
  vendorData        String?   @map("vendor_data") // Cached vendor data (JSON)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  connection        VendorConnection @relation(fields: [connectionId], references: [id])
  internalTicket    Ticket          @relation(fields: [internalTicketId], references: [id])

  @@unique([connectionId, internalTicketId])
  @@unique([connectionId, vendorTicketId])
  @@index([connectionId, syncStatus])
  @@map("vendor_ticket_mappings")
}

// Synchronization History
model VendorSyncHistory {
  id                String    @id @default(cuid())
  connectionId      String    @map("connection_id")
  syncType          String    @map("sync_type") // full, incremental, single_ticket
  syncDirection     String    @map("sync_direction") // inbound, outbound, bidirectional
  startedAt         DateTime  @map("started_at")
  completedAt       DateTime? @map("completed_at")
  status            String    @map("status") // running, completed, failed, partial
  totalRecords      Int       @default(0) @map("total_records")
  successfulRecords Int       @default(0) @map("successful_records")
  failedRecords     Int       @default(0) @map("failed_records")
  errorSummary      String?   @map("error_summary") // Kratak opis grešaka (UTF-8)
  detailedLog       String?   @map("detailed_log") // JSON log with details
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  connection VendorConnection @relation(fields: [connectionId], references: [id])

  @@index([connectionId, startedAt])
  @@index([status, createdAt])
  @@map("vendor_sync_history")
}

// Synchronization Queue
model VendorSyncQueue {
  id                String    @id @default(cuid())
  connectionId      String    @map("connection_id")
  ticketId          String?   @map("ticket_id")
  vendorTicketId    String?   @map("vendor_ticket_id")
  operationType     String    @map("operation_type") // create, update, delete, comment_add
  direction         String    @map("sync_direction") // inbound, outbound
  priority          Int       @default(5) // 1-10, higher is more urgent
  payload           String    @map("payload") // JSON data to sync
  status            String    @default("pending") // pending, processing, completed, failed
  retryCount        Int       @default(0) @map("retry_count")
  maxRetries        Int       @default(3) @map("max_retries")
  nextRetryAt       DateTime? @map("next_retry_at")
  errorMessage      String?   @map("error_message") // Poslednja greška (UTF-8)
  createdAt         DateTime  @default(now()) @map("created_at")
  processedAt       DateTime? @map("processed_at")

  // Relations
  connection VendorConnection @relation(fields: [connectionId], references: [id])
  ticket     Ticket?          @relation(fields: [ticketId], references: [id])

  @@index([connectionId, status, priority])
  @@index([status, nextRetryAt])
  @@map("vendor_sync_queue")
}

// Webhook Configuration
model VendorWebhook {
  id                String    @id @default(cuid())
  vendorSystemId    String    @map("vendor_system_id")
  webhookUrl        String    @map("webhook_url") // Our endpoint URL
  webhookSecret     String?   @map("webhook_secret") // Secret for validation
  eventTypes        String    @map("event_types") // JSON array of event types
  isActive          Boolean   @default(true) @map("is_active")
  lastReceivedAt    DateTime? @map("last_received_at")
  failureCount      Int       @default(0) @map("failure_count")
  maxFailures       Int       @default(10) @map("max_failures")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  vendorSystem VendorSystem @relation(fields: [vendorSystemId], references: [id])

  @@index([vendorSystemId, isActive])
  @@map("vendor_webhooks")
}

// Synchronization Error Log
model VendorSyncError {
  id                String    @id @default(cuid())
  connectionId      String    @map("connection_id")
  ticketId          String?   @map("ticket_id")
  vendorTicketId    String?   @map("vendor_ticket_id")
  errorType         String    @map("error_type") // validation, network, authentication, mapping, transformation
  errorCode         String?   @map("error_code")
  errorMessage      String    @map("error_message") // Poruka greške (UTF-8)
  errorDetails      String?   @map("error_details") // JSON with full error details
  stackTrace        String?   @map("stack_trace")
  resolution        String?   // Kako je rešeno (UTF-8)
  resolvedAt        DateTime? @map("resolved_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Relations
  connection VendorConnection @relation(fields: [connectionId], references: [id])
  ticket     Ticket?          @relation(fields: [ticketId], references: [id])

  @@index([connectionId, errorType, createdAt])
  @@index([ticketId])
  @@map("vendor_sync_errors")
}

