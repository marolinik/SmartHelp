{
  "name": "pio-help-desk-backend",
  "version": "1.0.0",
  "description": "Backend for PIO Help Desk System with Serbian language support",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "anonymize-db": "ts-node scripts/anonymize-database.ts",
    "anonymize-db:verify": "ts-node scripts/anonymize-database.ts --verify"
  },
  "keywords": [
    "helpdesk",
    "itsm",
    "serbian",
    "nodejs",
    "typescript",
    "prisma",
    "express",
    "ldap"
  ],
  "author": "PIO Fund Serbia",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tensorflow/tfjs-node": "^4.15.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/mailparser": "^3.4.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/ua-parser-js": "^0.7.39",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-force-ssl": "^0.3.2",
    "express-rate-limit": "^7.5.0",
    "express-slow-down": "^2.1.0",
    "express-validator": "^7.0.1",
    "geoip-lite": "^1.4.10",
    "helmet": "^7.2.0",
    "https": "^1.0.0",
    "ip-range-check": "^0.2.0",
    "ipaddr.js": "^2.2.0",
    "jsonwebtoken": "^9.0.2",
    "ldapjs": "^3.0.7",
    "mailparser": "^3.7.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "node-cron": "^4.1.0",
    "node-forge": "^1.3.1",
    "nodemailer": "^7.0.3",
    "socket.io": "^4.8.1",
    "ua-parser-js": "^2.0.3",
    "uuid": "^11.1.0",
    "winston": "^3.11.0",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.10.0",
    "@types/node-forge": "^1.3.11",
    "@types/uuid": "^10.0.0",
    "eslint": "^8.57.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
